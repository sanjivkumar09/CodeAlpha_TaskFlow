# TaskFlow Environment Variables Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Local, Docker or MongoDB Atlas)
# Note: If no local or remote MongoDB is reachable, TaskFlow automatically initializes
# an embedded in-memory MongoDB instance for instant execution!
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JSON Web Token Secret & Expiration
JWT_SECRET=taskflow_ultra_secure_jwt_secret_key_2026_codealpha
JWT_EXPIRES_IN=30d

# Client URL for CORS
CLIENT_URL=http://localhost:5173
